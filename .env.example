# Local development only. Never commit real values, and never expose any of
# these values through VITE_* variables or Android build configuration.
DATABASE_URL=mysql://fairmatch_app:replace-me@127.0.0.1:3306/fairmatch
JWT_SECRET=replace-with-a-random-32-plus-character-secret
APP_ORIGIN=http://127.0.0.1:3000
ANDROID_APP_ORIGIN=fairmatch://auth
NODE_ENV=development

# Optional: paste your Google AI Studio Gemini API key to enable live Gemini responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
