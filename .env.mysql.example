# MySQL must be remotely reachable from Railway/Vercel. Use TLS and a least-privilege application user.
DATABASE_URL=mysql://fairmatch_app:replace-me@your-mysql-host:3306/fairmatch?ssl={"rejectUnauthorized":true}
JWT_SECRET=replace-with-a-random-32-plus-character-secret
APP_ORIGIN=https://your-domain.vercel.app
# Android requests carry Bearer tokens; no browser CORS origin is needed for the installed app.
ANDROID_APP_ORIGIN=fairmatch://auth

# Server-only Google Gemini API key (paste your key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
